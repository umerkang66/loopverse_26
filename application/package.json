{
  "name": "ares-accord",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "simulate": "tsx --conditions=react-server --env-file-if-exists=.env scripts/simulate.ts",
    "reset:data": "node scripts/reset-data.mjs",
    "db:push": "node scripts/db.mjs push",
    "db:check": "node scripts/db.mjs check",
    "db:advisors": "node scripts/db.mjs advisors",
    "db:types": "node scripts/db.mjs types",
    "bench:models": "tsx --env-file-if-exists=.env scripts/bench-models.ts",
    "secret:scan": "node scripts/secret-scan.mjs",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@openai/agents": "0.20.0",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.54.0",
    "mermaid": "^12.1.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "openai": "^7.31.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "supabase": "2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.9"
  }
}
